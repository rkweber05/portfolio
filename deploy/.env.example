# Este arquivo é só um modelo. O .env REAL fica na VPS, em ~/app/.env, e nunca vai para o Git.

POSTGRES_USER=portfolio
# Gere com: openssl rand -hex 24   (use hex: caracteres como / + = quebram a URL do banco)
POSTGRES_PASSWORD=TROQUE_ISTO
POSTGRES_DB=portfolio

# Enquanto o provedor de e-mail não estiver configurado, o envio falha, mas
# a mensagem continua salva no banco (email_sent_at fica vazio).
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=
MAIL_FROM="Site <contato@rodrigoweber.com.br>"
MAIL_TO=seu-email@exemplo.com
