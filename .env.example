# Copie para .env. Sem .env, o docker-compose usa os valores padrão de desenvolvimento.

POSTGRES_USER=portfolio
POSTGRES_PASSWORD=portfolio_dev
POSTGRES_DB=portfolio

# Local: Mailpit (captura os e-mails, não envia nada de verdade).
# Produção: troque pelo SMTP do provedor (ex.: Resend) e preencha usuário e senha.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Site <site@localhost>"
MAIL_TO=voce@exemplo.com
